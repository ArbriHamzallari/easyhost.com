# ── Database (read this for reliable dev + Vercel deploys) ─────────────────────
#
# The app prefers DIRECT_URL for ALL runtime queries when it is a postgresql:// URL.
# That is the SAME database `prisma migrate deploy` / `db push` target — no drift.
#
# On Vercel: set DIRECT_URL to your Supabase *session pooler* URI (same as local).
# DATABASE_URL can be unset, or a second copy of that URI, or Prisma Accelerate — see below.
#
# Optional: DATABASE_URL=prisma+postgres://… only if Accelerate is linked to this Supabase
# project. If Accelerate points elsewhere you get “column does not exist” at random steps.
# PRISMA_FORCE_ACCELERATE=true forces Accelerate even when DIRECT_URL is set (advanced).
#
# Serverless pool size (optional, default 10): PG_POOL_MAX=5
#
DATABASE_URL=

# Direct Postgres (Supabase → Settings → Database → Connection string → URI)
# Required for `prisma migrate` / `db push` — Accelerate URLs cannot run migrations.
# Also used as the primary connection for the running app when set (recommended).
DIRECT_URL=

# Supabase (public keys for client-side Realtime; service role for server-only ops)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk (host authentication)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
# Clerk webhook signing secret (Dashboard → Webhooks → endpoint URL: /api/webhooks/clerk)
CLERK_WEBHOOK_SECRET=

# Paddle (host subscription billing — Starter €15/mo, Pro €29/mo)
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
PADDLE_STARTER_PRICE_ID=
PADDLE_PRO_PRICE_ID=
NEXT_PUBLIC_PADDLE_STARTER_PRICE_ID=
NEXT_PUBLIC_PADDLE_PRO_PRICE_ID=
# Optional: Paddle discount ID for early-bird 50% off for life (first 100 redemptions)
PADDLE_EARLY_BIRD_DISCOUNT_ID=

# Stripe Connect (guest payments to host — Apple Pay, Google Pay, card)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_CONNECT_CLIENT_ID=

# Google Translate (auto-translation of menu item names/descriptions)
GOOGLE_TRANSLATE_API_KEY=

# Google Maps (address autocomplete + timezone detection in onboarding)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Resend (transactional email — waitlist welcome, receipts, alerts)
RESEND_API_KEY=
RESEND_FROM_EMAIL=EasyHost <hello@easyhost.pro>
# Admin notification address for new waitlist signups
RESEND_NOTIFY_EMAIL=

# Cloudinary (logo, hero image, menu item photos)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# App URLs (canonical apex domain — marketing + dashboard on easyhost.pro)
NEXT_PUBLIC_APP_URL=https://easyhost.pro
NEXT_PUBLIC_MARKETING_URL=https://easyhost.pro

# Admin (Clerk user IDs allowed to view /admin/* — comma-separated)
ADMIN_USER_IDS=
